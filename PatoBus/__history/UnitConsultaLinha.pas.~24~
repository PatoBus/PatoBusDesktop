unit UnitConsultaLinha;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Data.DB,
  Vcl.StdCtrls, Vcl.Grids, Vcl.DBGrids, System.JSON, System.Net.HttpClient, UnitDMLinhas;

type
  TFormConsultaLinha = class(TForm)
    Panel1: TPanel;
    DBGrid1: TDBGrid;
    Panel2: TPanel;
    Splitter1: TSplitter;
    Button1: TButton;
    procedure FormCreate(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    { Private declarations }
  procedure setGrid(id:String);
  public
    { Public declarations }
  end;

var
  FormConsultaLinha: TFormConsultaLinha;

implementation

{$R *.dfm}

procedure TFormConsultaLinha.FormCreate(Sender: TObject);
begin
  // Conecta o DataSource ao TFDMemTable do DataModule
 //DataSource1.DataSet := dmLinhas.FDMemTable1;
  DBGrid1.DataSource := dmlinhas.DataSource1;
  setGrid('0');
end;

procedure TFormConsultaLinha.Button1Click(Sender: TObject);

begin
  setGrid('1');
end;

procedure TFormConsultaLinha.setGrid(id:String);
var
  Response: IHTTPResponse;
  JSONArray: TJSONArray;
  JSONValue: TJSONValue;
  Item: TJSONObject;
  Linha: TJSONObject;
  Empresa: TJSONObject;
  Horario: TJSONObject;
begin
  try
    // Faz a requisição HTTP
    Response := dmLinhas.NetHTTPClient1.Get('http://localhost:8081/linhas-horarios/horarios/'+id);

    // Converte a resposta JSON em array
    JSONArray := TJSONObject.ParseJSONValue(Response.ContentAsString) as TJSONArray;

    // Limpa e recria os campos do FDMemTable dinamicamente
    with dmLinhas.FDMemTable1 do
    begin
      Close;
      FieldDefs.Clear;
      Fields.Clear;
      IndexDefs.Clear;

      // Definir campos do FDMemTable com base no JSON
      //FieldDefs.Add('id', ftInteger);  // Campo ID
     /// FieldDefs.Add('linha_idLinha', ftInteger);  // Campo para id da linha
      FieldDefs.Add('linha_nome', ftString, 100);  // Nome da linha
      FieldDefs.Add('linha_valor', ftFloat);  // Valor da linha

     // FieldDefs.Add('horario_id', ftInteger);  // ID do horário
      FieldDefs.Add('horario_hora', ftString, 8);  // Hora do horário

      CreateDataSet;
      Open;
    end;

    // Preenche os dados a partir do JSON
    for JSONValue in JSONArray do
    begin
      Item := JSONValue as TJSONObject;
      Linha := Item.GetValue<TJSONObject>('linha');
      Empresa := Linha.GetValue<TJSONObject>('empresa');
      Horario := Item.GetValue<TJSONObject>('horario');

      dmLinhas.FDMemTable1.Append;
      // Preenchendo os campos do FDMemTable com base no JSON
      dmLinhas.FDMemTable1.FieldByName('linha_nome').AsString := Linha.GetValue<string>('nome');
      dmLinhas.FDMemTable1.FieldByName('linha_valor').AsFloat := Linha.GetValue<Single>('valor');
      //dmLinhas.FDMemTable1.FieldByName('linha_empresa_idEmpresa').AsInteger := Empresa.GetValue<Integer>('idEmpresa');

      //dmLinhas.FDMemTable1.FieldByName('horario_id').AsInteger := Horario.GetValue<Integer>('id');
      dmLinhas.FDMemTable1.FieldByName('horario_hora').AsString := Horario.GetValue<string>('hora');
      dmLinhas.FDMemTable1.Post;
    end;

    JSONArray.Free;
    with DBGrid1 do
    begin
      Columns[0].Title.Caption := 'Nome da Linha';
      Columns[0].Width := 150;

      Columns[1].Title.Caption := 'Valor da Linha';
      Columns[1].Width := 100;

      //Columns[2].Title.Caption := 'ID do Horário';
      //Columns[2].Width := 80;

      Columns[2].Title.Caption := 'Hora';
      Columns[2].Width := 80;
    end;

  except
    on E: Exception do
      ShowMessage('Erro ao consultar dados: ' + E.Message);
  end;
end;


end.

