unit UnitConsultaLinha;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.ExtCtrls, Data.DB,
  Vcl.StdCtrls, Vcl.Grids, Vcl.DBGrids, System.JSON, System.Net.HttpClient,
  UnitDMLinhas;

type
  TFormConsultaLinha = class(TForm)
    Panel1: TPanel;
    DBGrid1: TDBGrid;
    Panel2: TPanel;
    Splitter1: TSplitter;
    Button1: TButton;
    procedure FormCreate(Sender: TObject);
    procedure Button1Click(Sender: TObject);
  private
    procedure setGrid(const id: String);
  public
  end;

var
  FormConsultaLinha: TFormConsultaLinha;

implementation

{$R *.dfm}

procedure TFormConsultaLinha.FormCreate(Sender: TObject);
begin
  // Cria o DataModule, se ainda não existir
  if not Assigned(dmLinhas) then
    dmLinhas := TdmLinhas.Create(Self);

  // Conecta o DBGrid ao DataSource
  if Assigned(dmLinhas.DataSource1) then
    DBGrid1.DataSource := dmLinhas.DataSource1;

  // Carrega os dados iniciais
  setGrid('0');
end;

procedure TFormConsultaLinha.Button1Click(Sender: TObject);
begin
  setGrid('2');
end;

procedure TFormConsultaLinha.setGrid(const id: String);
var
  Response: IHTTPResponse;
  JSONArray: TJSONArray;
  JSONValue: TJSONValue;
  Item, Linha, Empresa, Horario: TJSONObject;
begin
  try
    // Requisição HTTP
    Response := dmLinhas.NetHTTPClient1.Get('http://localhost:8081/linhas-horarios/horarios/' + id);
    JSONArray := TJSONObject.ParseJSONValue(Response.ContentAsString) as TJSONArray;

    if not Assigned(JSONArray) then
      raise Exception.Create('Resposta JSON inválida.');

    // Recriação segura do FDMemTable1
    with dmLinhas.FDMemTable1 do
    begin
      Active := False;
      Close;
      FieldDefs.Clear;
      Fields.Clear;
      IndexDefs.Clear;

      FieldDefs.Add('linha_nome', ftString, 100);
      FieldDefs.Add('linha_valor', ftFloat);
      FieldDefs.Add('horario_hora', ftString, 8);

      CreateDataSet;
      Open;
    end;

    // Preencher dados do JSON
    for JSONValue in JSONArray do
    begin
      Item := JSONValue as TJSONObject;
      Linha := Item.GetValue<TJSONObject>('linha');
      Empresa := Linha.GetValue<TJSONObject>('empresa');
      Horario := Item.GetValue<TJSONObject>('horario');

      with dmLinhas.FDMemTable1 do
      begin
        Append;
        FieldByName('linha_nome').AsString := Linha.GetValue<string>('nome');
        FieldByName('linha_valor').AsFloat := Linha.GetValue<Double>('valor');
        FieldByName('horario_hora').AsString := Horario.GetValue<string>('hora');
        Post;
      end;
    end;

    JSONArray.Free;

    // Força ligação do DataSource (reconfirmação)
    dmLinhas.DataSource1.DataSet := dmLinhas.FDMemTable1;
    DBGrid1.DataSource := dmLinhas.DataSource1;

    // ? Mantém ajustes visuais do Grid
    with DBGrid1 do
    begin
      if Columns.Count >= 3 then
      begin
        Columns[0].Title.Caption := 'Nome da Linha';
        Columns[0].Width := 150;

        Columns[1].Title.Caption := 'Valor da Linha';
        Columns[1].Width := 100;

        Columns[2].Title.Caption := 'Hora';
        Columns[2].Width := 80;
      end;
    end;

  except
    on E: Exception do
      ShowMessage('Erro ao consultar dados: ' + E.Message);
  end;
end;


end.

