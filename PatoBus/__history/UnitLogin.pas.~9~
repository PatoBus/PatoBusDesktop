{$R *.dfm}

procedure CentralizarImagemComQualidade(Image: TImage);
var
  Bmp: TBitmap;
  SrcWidth, SrcHeight: Integer;
  DstWidth, DstHeight: Integer;
  DstX, DstY: Integer;
begin
  if not Assigned(Image.Picture.Graphic) then Exit;

  // Cria bitmap intermediário com suavização
  Bmp := TBitmap.Create;
  try
    SrcWidth := Image.Picture.Graphic.Width;
    SrcHeight := Image.Picture.Graphic.Height;

    // Calcula proporção para ajustar a imagem mantendo a qualidade
    if SrcWidth / SrcHeight > Image.Width / Image.Height then
    begin
      DstWidth := Image.Width;
      DstHeight := Round(SrcHeight * (Image.Width / SrcWidth));
    end
    else
    begin
      DstHeight := Image.Height;
      DstWidth := Round(SrcWidth * (Image.Height / SrcHeight));
    end;

    // Calcula posição centralizada
    DstX := (Image.Width - DstWidth) div 2;
    DstY := (Image.Height - DstHeight) div 2;

    // Prepara bitmap com mesmo tamanho do TImage
    Bmp.SetSize(Image.Width, Image.Height);
    Bmp.Canvas.Brush.Color := clWhite; // Ou qualquer fundo
    Bmp.Canvas.FillRect(Bmp.Canvas.ClipRect);

    // Copia a imagem com alta qualidade (stretch draw)
    Bmp.Canvas.StretchDraw(Rect(DstX, DstY, DstX + DstWidth, DstY + DstHeight), Image.Picture.Graphic);

    // Aplica ao TImage
    Image.Picture.Assign(Bmp);
    Image.Stretch := False;
  finally
    Bmp.Free;
  end;
end;


procedure TFormLogin.BtnLoginClick(Sender: TObject);
